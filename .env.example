# Reputo local development environment
#
# Copy this file to `.env` at the repo root and fill in the placeholders.
# This is the single env template for local development.
#
# Source of truth for which vars exist and how they're validated:
#   apps/api/src/config/env.ts
#   apps/ui/src/lib/env.ts
#   apps/workflows/src/config/env.ts
#
# Vars marked OPTIONAL have a Zod default — list them here only if you need to
# override the default locally. Vars marked REQUIRED have no default; the app
# refuses to start without them. SECRET values must never be committed.
#
# Staging/production values live in Komodo Variables, not here.

# =============================================================================
# Runtime
# =============================================================================

# REQUIRED (api + workflows): one of production | development | test
NODE_ENV=development

# OPTIONAL (api + workflows): Pino log level. Default: info
# LOG_LEVEL=info

# =============================================================================
# API HTTP server (apps/api)
# =============================================================================

# OPTIONAL: HTTP port. Default: 3000
# PORT=3000

# REQUIRED: Public URL the UI is served at; the API redirects here after login.
APP_PUBLIC_URL=http://localhost:4000

# =============================================================================
# Authentication (apps/api)
# =============================================================================

# OPTIONAL: oauth | mock. Default: oauth. mock is rejected in production.
# AUTH_MODE=oauth

# REQUIRED when AUTH_MODE=oauth: email seeded as the single owner allowlist entry.
OWNER_EMAIL=owner@example.com

# OPTIONAL: OAuth provider the owner is seeded against. Default: deep-id
# OWNER_PROVIDER=deep-id

# REQUIRED: Deep ID OIDC issuer (shared by both clients).
DEEP_ID_ISSUER_URL=https://identity.deep-id.ai

# REQUIRED: Deep ID admin client (interactive login).
DEEP_ID_ADMIN_CLIENT_ID=
DEEP_ID_ADMIN_CLIENT_SECRET=                    # SECRET
DEEP_ID_ADMIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/deep-id/callback
DEEP_ID_ADMIN_SCOPES=openid profile email offline_access

# REQUIRED: Deep ID consent flow (authorizes the DEEP_ID_CLIENT_* client below).
# Must include the four *_encr scopes: the encrypted custom_score lifecycle can
# only read child ciphertexts of users whose consent covers them. The github,
# discord, and mattermost scopes carry the linked usernames the community
# algorithms match on; without them a user is never scored on that platform.
DEEP_ID_CONSENT_REDIRECT_URI=http://localhost:3000/api/v1/oauth/consent/deep-id/callback
DEEP_ID_CONSENT_GRANT_TTL_SECONDS=600
VOTING_PORTAL_RETURN_URL=http://localhost:3001/voting
DEEP_ID_CONSENT_SCOPES=api wallets post_scores voting_engagement_encr contribution_score_encr proposal_engagement_encr token_value_over_time_encr github discord mattermost

# OPTIONAL: Default 300000 (5 min).
# DEEP_ID_CONSENT_CLEANUP_INTERVAL_MS=300000

# OPTIONAL: Cookie shape. Defaults: name=reputo_auth_session, secure=false,
# same_site=lax, ttl=2592000, refresh_leeway=60, cleanup_interval=3600000
# AUTH_COOKIE_NAME=reputo_auth_session
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAME_SITE=lax
# AUTH_SESSION_TTL_SECONDS=2592000
# AUTH_REFRESH_LEEWAY_SECONDS=60
# AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000

# REQUIRED: 32+ chars. Generate with `openssl rand -hex 32`. SECRET.
AUTH_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# Community connections (apps/api + apps/workflows)
# =============================================================================
# Discord bot install flow and read-only guild calls. Create the application at
# https://discord.com/developers/applications, add the callback URL below to its
# OAuth2 redirects, and copy the bot token. The bot needs no privileged intents:
# Reputo asks only for View Channels and Read Message History.

# REQUIRED.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=                          # SECRET
DISCORD_BOT_TOKEN=                              # SECRET — never stored in the database; also read by the community worker
DISCORD_BOT_CALLBACK_URL=http://localhost:3000/api/v1/community/connections/discord/callback

# GitHub App install flow and read-only repository crawls. Create the App at
# https://github.com/settings/apps with read-only Issues, Pull requests, and
# Metadata permissions, set its Setup URL to GITHUB_APP_CALLBACK_URL below, and
# generate a private key. GitHub has no redirect parameter for installs, so the
# Setup URL must match that value exactly. Paste the PEM as one line with \n
# escapes; the API and the community worker unescape it.

# REQUIRED (API + community worker).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=                         # SECRET — never stored in the database; also read by the community worker
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/v1/community/connections/github/callback

# Mattermost token-mode connect (current ESR and newer). The admin pastes a
# server URL + bot token in the UI; the token is sealed at rest with the key
# below. The outbound policy blocks private/internal targets and plain http
# unless the host is on the allowlist — for local dev, allowlist the dev
# Mattermost container (localhost from `pnpm dev`, mattermost inside Docker).

# REQUIRED (api + workflows): 32+ chars. Generate with `openssl rand -hex 32`. SECRET.
COMMUNITY_CREDENTIALS_ENCRYPTION_KEY=

# OPTIONAL: previous sealing key, set only while rotating. SECRET.
# COMMUNITY_CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# OPTIONAL: comma-separated hostnames exempt from the HTTPS/public-address
# rules. Deployment configuration — leave empty in production unless an
# internal server is intentionally reachable. Default: empty (deny all private).
COMMUNITY_MATTERMOST_ALLOWED_HOSTS=localhost

# OPTIONAL tuning. Defaults: install_state_ttl=600, timeout=15000,
# retry_max=4, retry_base_ms=500, retry_max_ms=10000,
# mattermost_max_response_bytes=5242880.
# COMMUNITY_INSTALL_STATE_TTL_SECONDS=600
# COMMUNITY_API_REQUEST_TIMEOUT_MS=15000
# COMMUNITY_API_RETRY_MAX_ATTEMPTS=4
# COMMUNITY_API_RETRY_BASE_DELAY_MS=500
# COMMUNITY_API_RETRY_MAX_DELAY_MS=10000
# COMMUNITY_MATTERMOST_MAX_RESPONSE_BYTES=5242880

# =============================================================================
# Application database (apps/api)
# =============================================================================

# REQUIRED: postgres:// URL. For dev, points at infra/dev/compose.yml's
# `postgres` service (host port 5434). Credentials in the URL must match what
# infra/dev/compose.yml hardcodes for the postgres container.
DATABASE_URL=postgresql://reputo_app:reputo_app@localhost:5434/reputo_app

# =============================================================================
# Onchain-data database (apps/workflows)
# =============================================================================

# REQUIRED: postgres:// URL for the onchain-data worker. For dev, points at
# infra/dev/compose.yml's `onchain-data-postgresql` service (host port 5433).
ONCHAIN_DATABASE_URL=postgresql://reputo_onchain:reputo_onchain@localhost:5433/reputo_onchain

# =============================================================================
# Application database, read-only (apps/workflows)
# =============================================================================

# REQUIRED: postgres:// URL the community worker uses to read connection rows
# and sealed credentials. Must be a READ-ONLY role — `pnpm docker:up` creates
# `reputo_app_readonly` (SELECT on community_connections only) via the
# `db-readonly-role` one-shot service; production provisioning is documented in
# docs/deployment.md.
APP_DATABASE_URL=postgresql://reputo_app_readonly:reputo_app_readonly@localhost:5434/reputo_app

# =============================================================================
# AWS / object storage (apps/api + apps/workflows)
# =============================================================================

# REQUIRED.
AWS_REGION=eu-north-1


# REQUIRED: S3 (or S3-compatible) bucket for algorithm inputs/outputs.
STORAGE_BUCKET=reputo-snapshots

# OPTIONAL: custom S3 endpoint. Set together with STORAGE_FORCE_PATH_STYLE=true
# to point at MinIO / LocalStack instead of AWS S3. Omitted in prod/staging.
# `pnpm docker:up` sets these in-network to http://minio:9000 automatically.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_FORCE_PATH_STYLE=true

# OPTIONAL: presigned URL TTLs (seconds) and upload limits.
# Defaults: PUT_TTL=120, GET_TTL=300, MAX_SIZE_BYTES=52428800 (50 MiB),
# ALLOWLIST="text/csv,text/plain,application/json".
# STORAGE_PRESIGN_PUT_TTL=120
# STORAGE_PRESIGN_GET_TTL=300
# STORAGE_MAX_SIZE_BYTES=52428800
# STORAGE_CONTENT_TYPE_ALLOWLIST=text/csv,text/plain,application/json

# =============================================================================
# Temporal (apps/api + apps/workflows)
# =============================================================================

# REQUIRED: Temporal server host:port. Use `temporal:7233` inside docker compose,
# `localhost:7233` from a host shell during `pnpm dev`.
TEMPORAL_ADDRESS=localhost:7233

# OPTIONAL: namespace + task-queue names. Defaults wired to the docker dev stack.
# TEMPORAL_NAMESPACE=default
# TEMPORAL_ORCHESTRATOR_TASK_QUEUE=orchestrator-worker
# TEMPORAL_ALGORITHM_TYPESCRIPT_TASK_QUEUE=algorithm-typescript-worker
# TEMPORAL_ALGORITHM_PYTHON_TASK_QUEUE=algorithm-python-worker
# TEMPORAL_ONCHAIN_DATA_TASK_QUEUE=onchain-data-worker
# TEMPORAL_COMMUNITY_TASK_QUEUE=community-worker
# TEMPORAL_API_SNAPSHOT_ACTIVITIES_TASK_QUEUE=api-snapshot-activities

# OPTIONAL: snapshot lifecycle guards (apps/api). The reachability probe feeds
# /health; the reconciler settles snapshots whose workflow died, timed out, or
# never started. 0 disables the probe/reconciler.
# TEMPORAL_HEALTH_CHECK_INTERVAL_MS=30000
# SNAPSHOT_RECONCILE_INTERVAL_MS=60000
# SNAPSHOT_RECONCILE_GRACE_MS=120000
# SNAPSHOT_START_FAILED_AFTER_MS=600000

# =============================================================================
# DeepFunding Portal API (apps/workflows)
# =============================================================================

# REQUIRED.
DEEPFUNDING_API_BASE_URL=https://deep-projects.ai/wp-json/deepfunding/v1
DEEPFUNDING_API_KEY=                              # SECRET

# OPTIONAL tuning. Defaults: timeout=45000, concurrency=4, page_limit=500,
# retry_max=7, retry_base_ms=500, retry_max_ms=20000.
# DEEPFUNDING_API_REQUEST_TIMEOUT_MS=45000
# DEEPFUNDING_API_CONCURRENCY=4
# DEEPFUNDING_API_DEFAULT_PAGE_LIMIT=500
# DEEPFUNDING_API_RETRY_MAX_ATTEMPTS=7
# DEEPFUNDING_API_RETRY_BASE_DELAY_MS=500
# DEEPFUNDING_API_RETRY_MAX_DELAY_MS=20000

# =============================================================================
# Onchain data providers (apps/workflows)
# =============================================================================

# REQUIRED — both SECRETS.
ALCHEMY_API_KEY=
BLOCKFROST_API_KEY=

# =============================================================================
# DeepID client (apps/workflows + apps/api consent)
# =============================================================================
# Reads consented users (GET /v1/users) and posts scores (POST /v1/clients/scores).
# Shared by the API consent flow, which authorizes this same client.

# REQUIRED (app /v1 host; the token host is DEEP_ID_ISSUER_URL above).
DEEP_ID_APP_BASE_URL=https://app.staging.deep-id.ai
DEEP_ID_CLIENT_ID=                            # SECRET
DEEP_ID_CLIENT_SECRET=                        # SECRET

# OPTIONAL tuning. Defaults: scopes='api wallets post_scores github discord mattermost',
# timeout=30000, concurrency=4, users_page_size=100, retry_max=5,
# retry_base_ms=500, retry_max_ms=20000.
# The encrypted custom_score activities ignore DEEP_ID_SCOPES and request
# 'api' plus the selected children's *_encr scopes per run; the DeepID client
# registration must allow every scope above for its client-credentials tokens.
# DEEP_ID_SCOPES=api wallets post_scores github discord mattermost
# DEEP_ID_REQUEST_TIMEOUT_MS=30000
# DEEP_ID_CONCURRENCY=4
# DEEP_ID_USERS_PAGE_SIZE=100
# DEEP_ID_RETRY_MAX_ATTEMPTS=5
# DEEP_ID_RETRY_BASE_DELAY_MS=500
# DEEP_ID_RETRY_MAX_DELAY_MS=20000

# =============================================================================
# UI (apps/ui)
# =============================================================================

# OPTIONAL: cookie name; must match the API's AUTH_COOKIE_NAME if either is set.
# Default: reputo_auth_session
# AUTH_COOKIE_NAME=reputo_auth_session

# OPTIONAL: dev-only Next.js rewrite target. Leave unset in Docker (Traefik
# routes /api). Default: unset.
API_PROXY_TARGET=http://localhost:3000
