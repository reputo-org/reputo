{
    "key": "mattermost_engagement",
    "name": "Mattermost Engagement",
    "kind": "standalone",
    "category": "Engagement",
    "summary": "Scores activity for each Mattermost user who has given consent. You choose the points and daily limit for each activity.",
    "description": "### What it does\nScores activity from users who gave DeepID permission to use their Mattermost account.\n\n### How it works\n- When the snapshot starts, Reputo saves a fixed copy of activity from the selected channels for the chosen time period. The bot can read only channels it has joined.\n- Reputo matches each user to their Mattermost account by username. If it cannot find a match, the user gets a score of `0` and is marked as unmatched.\n- Each enabled activity earns the points you set. A daily limit sets the maximum number of times each activity is counted for one user on one UTC day.\n- `active_day` counts one day when the user sends at least one message or reply. Its daily limit sets the maximum number of active days counted in the time period.\n- The final score is the total of all points. Reputo does not adjust it to a fixed range unless you use it in Custom Score.\n- Bots, system messages, and deleted posts are not scored. Leave an activity out if you do not want to score it.\n\n### Data used\nActivity totals from the selected Mattermost channels and the Mattermost usernames that users linked through DeepID.\n\n### Results\n- A CSV file with `did`, the `mattermost_engagement` score, and the points earned from each activity.\n- A JSON file with activity counts, account match status, and channel coverage for each user.",
    "version": "1.0.0",
    "inputs": [
        {
            "key": "community_connection_id",
            "label": "Mattermost team",
            "description": "The connected Mattermost team to score. Connect one on the Communities page first.",
            "type": "string",
            "required": true,
            "uiHint": {
                "widget": "community_connection",
                "platform": "mattermost"
            }
        },
        {
            "key": "resources",
            "label": "Channels",
            "description": "The channels to include. The bot must be a member of a channel to read it.",
            "type": "array",
            "minItems": 1,
            "required": true,
            "item": {
                "type": "string"
            },
            "uiHint": {
                "widget": "community_resources",
                "dependsOn": "community_connection_id"
            }
        },
        {
            "key": "lookback_days",
            "label": "Time period (days)",
            "description": "Number of previous days of activity to include, counted back from when the snapshot starts.",
            "type": "integer",
            "min": 1,
            "max": 183,
            "default": 90,
            "step": 1,
            "required": true,
            "uiHint": {
                "widget": "number",
                "suffix": "days",
                "presets": [
                    7,
                    30,
                    90,
                    183
                ]
            }
        },
        {
            "key": "activities",
            "label": "Activity points and limits",
            "description": "Set the points and daily limit for each activity. Points must be above `0`. Leave an activity out if you do not want to score it.",
            "type": "array",
            "minItems": 1,
            "required": true,
            "uniqueBy": [
                "activity"
            ],
            "item": {
                "type": "object",
                "properties": [
                    {
                        "key": "activity",
                        "label": "Activity",
                        "description": "The activity this row scores.",
                        "type": "string",
                        "required": true,
                        "enum": [
                            "message",
                            "reply",
                            "reaction_received",
                            "reply_received",
                            "active_day"
                        ],
                        "uiHint": {
                            "widget": "select",
                            "options": [
                                {
                                    "value": "message",
                                    "label": "Message sent"
                                },
                                {
                                    "value": "reply",
                                    "label": "Reply sent"
                                },
                                {
                                    "value": "reaction_received",
                                    "label": "Reaction received"
                                },
                                {
                                    "value": "reply_received",
                                    "label": "Reply received"
                                },
                                {
                                    "value": "active_day",
                                    "label": "Active day"
                                }
                            ]
                        }
                    },
                    {
                        "key": "points",
                        "label": "Points",
                        "description": "Points earned each time this activity is counted. Must be above `0`.",
                        "type": "number",
                        "min": 0,
                        "exclusiveMin": true,
                        "required": true
                    },
                    {
                        "key": "daily_cap",
                        "label": "Daily limit",
                        "description": "Maximum number of times this activity is counted for one user on one UTC day.",
                        "type": "integer",
                        "min": 1,
                        "required": true
                    }
                ]
            },
            "uiHint": {
                "widget": "repeater",
                "addButtonLabel": "Add activity",
                "presets": [
                    {
                        "label": "Recommended settings",
                        "value": [
                            {
                                "activity": "message",
                                "points": 1,
                                "daily_cap": 25
                            },
                            {
                                "activity": "reply",
                                "points": 1.5,
                                "daily_cap": 25
                            },
                            {
                                "activity": "reaction_received",
                                "points": 0.25,
                                "daily_cap": 50
                            },
                            {
                                "activity": "reply_received",
                                "points": 1,
                                "daily_cap": 25
                            },
                            {
                                "activity": "active_day",
                                "points": 2,
                                "daily_cap": 30
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "outputs": [
        {
            "key": "mattermost_engagement",
            "label": "Mattermost engagement (CSV)",
            "description": "One row for each user who gave consent, with their score and the points earned from each activity. Users without a matched account have a score of `0`.",
            "type": "csv",
            "csv": {
                "hasHeader": true,
                "delimiter": ",",
                "columns": [
                    {
                        "key": "did",
                        "type": "string",
                        "description": "DeepID user identifier (DID; `did:sub`)."
                    },
                    {
                        "key": "mattermost_engagement",
                        "type": "number",
                        "description": "Final engagement score: the total points earned from all activities."
                    },
                    {
                        "key": "message_points",
                        "type": "number",
                        "description": "Points earned from messages."
                    },
                    {
                        "key": "reply_points",
                        "type": "number",
                        "description": "Points earned from replies."
                    },
                    {
                        "key": "reaction_received_points",
                        "type": "number",
                        "description": "Points earned from reactions received."
                    },
                    {
                        "key": "reply_received_points",
                        "type": "number",
                        "description": "Points earned from replies received."
                    },
                    {
                        "key": "active_day_points",
                        "type": "number",
                        "description": "Points earned from active days."
                    }
                ]
            }
        },
        {
            "key": "mattermost_engagement_details",
            "label": "Mattermost engagement details (JSON)",
            "description": "Activity counts, account match status, and channel coverage for each user in the selected time period.",
            "type": "json"
        }
    ],
    "runtime": "typescript",
    "dependencies": [
        {
            "key": "mattermost-activity"
        }
    ]
}
